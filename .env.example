# Application
APP_NAME="dockchat"
APP_VERSION="2.2.0"
DEBUG=true

# JWT Configuration
JWT_SECRET="change-me-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# Database (leave empty to run in in-memory mode without PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/dockchat"
REDIS_URL="redis://localhost:6379/0"

# Optional seeded admin (all three required to enable). Created on startup if
# missing; grants superuser so the Containers tab can list all host containers.
SEED_ADMIN_USERNAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# AI Providers
VLLM_URL="http://security.ai/v1"
VLLM_MODEL="Qwen/Qwen3-8B"
VLLM_API_KEY=""  # bearer token for secured vLLM endpoints (leave empty for local unsecured vLLM)
VLLM_ENABLE_TOOLS="false"  # set true only if vLLM was launched with --enable-auto-tool-choice --tool-call-parser
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# Docker
DOCKER_HOST="unix:///var/run/docker.sock"
ALLOWED_PATHS="/home:/workspace:/tmp"

# Security / CORS
ALLOWED_ORIGINS="http://localhost:8501,http://localhost:3000"

# Frontend
API_BASE_URL="http://localhost:8080"
